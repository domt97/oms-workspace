{
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git tag *)",
      "Bash(git * commit *)",
      "Bash(git * push *)",
      "Bash(git * merge *)",
      "Bash(git * rebase *)",
      "Bash(git * reset *)",
      "Bash(git * tag *)",
      "Bash(gh release *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * master)",
      "Bash(git push * develop)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * HEAD:develop)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git * push --force *)",
      "Bash(git * push -f *)",
      "Bash(git * push * --force)",
      "Bash(git * push * -f)",
      "Bash(git * push * --force-with-lease)",
      "Bash(git * push * master)",
      "Bash(git * push * develop)",
      "Bash(git * push * HEAD:master)",
      "Bash(git * push * HEAD:develop)",
      "Bash(git * reset --hard *)",
      "Bash(git * branch -D *)",
      "Bash(git * branch -d *)",
      "Bash(git * branch --delete *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_git.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
